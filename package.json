{
  "name": "lawson-config-redactor",
  "displayName": "Network Config Redactor — Lawson Cyber LLC",
  "description": "Redact supported Cisco, Palo Alto, Juniper, and Dell configurations locally. Choose the device format. Review before sharing. No uploads.",
  "version": "0.4.0",
  "publisher": "DerickL",
  "author": "Lawson Cyber LLC",
  "license": "MIT",
  "private": true,
  "preview": true,
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "lawsonRedactor.preview",
        "title": "Lawson Cyber: Preview Redacted Configuration"
      },
      {
        "command": "lawsonRedactor.selection",
        "title": "Lawson Cyber: Redact Selected Text"
      },
      {
        "command": "lawsonRedactor.demo",
        "title": "Lawson Cyber: Open Redactor Demo"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "test:host": "npm run compile && node scripts/test-host.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "5.9.3"
  },
  "homepage": "https://lawsoncyber.com",
  "galleryBanner": {
    "color": "#3a2414",
    "theme": "dark"
  },
  "keywords": [
    "cisco",
    "ios",
    "ios-xe",
    "network",
    "config",
    "redact",
    "redaction",
    "password",
    "secret",
    "privacy",
    "offline",
    "local",
    "juniper",
    "junos",
    "palo-alto",
    "pan-os",
    "dell"
  ],
  "extensionKind": [
    "ui"
  ],
  "bugs": {
    "email": "derick@lawsoncyber.com",
    "url": "https://github.com/palthainon/lawson-config-redactor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/palthainon/lawson-config-redactor.git"
  },
  "vsce": {
    "baseImagesUrl": "https://raw.githubusercontent.com/palthainon/lawson-config-redactor/72f3654792fc9cfbc2255cd0892bea41dc281f88/",
    "dependencies": false
  }
}
