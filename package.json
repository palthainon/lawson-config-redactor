{
  "name": "lawson-config-redactor",
  "displayName": "Network Config Redactor — Lawson Cyber LLC",
  "description": "Preview a redacted Cisco IOS or IOS-XE configuration for technical review.",
  "version": "0.2.0",
  "publisher": "DerickL",
  "author": "Lawson Cyber LLC",
  "license": "UNLICENSED",
  "private": true,
  "preview": true,
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "lawsonRedactor.preview",
        "title": "Lawson Cyber: Preview Redacted Configuration"
      },
      {
        "command": "lawsonRedactor.selection",
        "title": "Lawson Cyber: Redact Selected Text"
      },
      {
        "command": "lawsonRedactor.demo",
        "title": "Lawson Cyber: Open Redactor Demo"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "test:host": "npm run compile && node scripts/test-host.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "5.9.3"
  }
}
