! Synthetic Cisco IOS-XE review input. Do not deploy this file.
! Public ranges are artificial topology values. They are not company addresses.
hostname CLIENT-A
ip domain name review.invalid
service password-encryption
enable secret 5 $1$LabOnly1$5uCW9.eeLZPF0OF2rgRB81
enable password 7 003736232016242823180160262D48365F2F293203080165031411372429367F
username SEED-ADMIN privilege 15 secret 9 SEED-ADMIN-TYPE9
username SEED-OPERATOR secret 8 SEED-OPERATOR-TYPE8
aaa new-model
aaa authentication login default group tacacs+ local
tacacs server REVIEW-TACACS
 address ipv4 10.42.1.20
 key 6 SEED-TACACS-TYPE6
!
radius server REVIEW-RADIUS
 address ipv4 172.20.1.20 auth-port 1812 acct-port 1813
 key 7 003736232016242823180160262D48365F2F293203080165031411372429367F
!
aaa group server tacacs+ REVIEW-AAA
 server-private 192.168.1.20 key 0 SEED-PRIVATE-SERVER
!
tacacs-server key 7 003736232016242823180160262D48365F2F293203080165031411372429367F
radius-server key 0 SEED-LEGACY-RADIUS
snmp-server community SEED-SNMP-COMMUNITY RO
snmp-server user SEED-SNMP-USER REVIEW-SNMP v3 auth md5 SEED-SNMP-AUTH priv aes 128 SEED-SNMP-PRIV
snmp-server host 8.8.8.25 version 2c SEED-SNMP-DESTINATION
ntp authentication-key 10 md5 SEED-NTP-MD5 7
crypto isakmp key SEED-IPSEC-SHARED address 9.9.9.25
crypto ikev2 keyring REVIEW-IKE
 peer REVIEW-PEER
  address 9.9.9.2
  pre-shared-key local 6 SEED-IKE-LOCAL
  pre-shared-key remote 6 SEED-IKE-REMOTE
!
banner login ^C
Synthetic review banner. Contact SEED-BANNER-OWNER.
^C
!
interface GigabitEthernet0/0/0
 description Synthetic public uplink 0
 ip address 8.8.8.1 255.255.255.0
!
ip prefix-list PUBLIC-0 seq 10 permit 8.8.8.0/24
